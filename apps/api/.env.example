NODE_ENV=development
PORT=4000
WEB_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://manicuba:manicuba@localhost:5432/manicuba?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Storage: "local" or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# S3 / R2 / MinIO (only if STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Manicuba <no-reply@manicuba.app>"

SMS_DRIVER=noop
# For future Cubacel adapter:
SMS_CUBACEL_API_URL=
SMS_CUBACEL_API_KEY=

# Reminders: minutes before appointment
REMINDER_LEAD_MINUTES=1440
